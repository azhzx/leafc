#lang("builtin_i8_type")
type Int8;

#lang("builtin_i32_type")
type Int32;

#lang("builtin_i64_type")
type Int64;

#lang("builtin_never_type")
type Never;

#lang("builtin_f64_type")
type Float64;

#lang("builtin_ptr_type")
type __RawPtr;

external ctype Foo;


external fun puts(a: __RawPtr) -> () = "leaf_rt__puts";
external fun itoa(a: Int32) -> __RawPtr = "leaf_rt__itoa";
external fun dtoa(val: Float64) -> __RawPtr = "leaf_rt__dtoa";
external fun now() -> Float64 = "leaf_rt__now";

fun fib(n)
    return when n
        0 => 0
        1 => 1
        _ => fib(n - 1) + fib(n - 2)


fun main()
    let start = unsafe_call_external now()

    let fib30 = fib(35)
    unsafe_call_external puts(unsafe_call_external itoa(fib30))

    let end = unsafe_call_external now()
    unsafe_call_external puts(unsafe_call_external dtoa(end - start))