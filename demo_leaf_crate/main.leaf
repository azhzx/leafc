#lang("builtin_i8_type")
type Int8;

#lang("builtin_u8_type")
type UInt8;

#lang("builtin_i32_type")
type Int32;

#lang("builtin_i64_type")
type Int64;

type Int = Int32

#lang("builtin_never_type")
type Never;

#lang("builtin_f64_type")
type Float64;

type Float = Float64

#lang("builtin_c_void_ptr_type")
type CVoidPtr;

#lang("builtin_raw_ptr_type")
type RawPtr[T];

#lang("builtin_c_char_type")
type CChar;



external fun puts(a: CVoidPtr) -> ()  = "leaf_rt__puts";
external fun itoa(a: Int32) -> CVoidPtr = "leaf_rt__itoa";


fun print_int(a)
    unsafe_call_external puts(unsafe_call_external itoa(a))

type Maybe [t]
    | Just of t
    | None

type Expr [a]
    | MakeInt of Int -> Expr[Int]
    | MakeFloat of Float -> Expr[Float]

fun eval[T] (a: Expr[T]) -> T
    return when a
        Expr.MakeInt(binding i) => i
        Expr.MakeFloat(binding f) => f

fun main()
    let x = eval( Expr.MakeInt(42) )
    print_int(x)