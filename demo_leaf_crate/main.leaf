#lang("builtin_i8_type")
type Int8;

#lang("builtin_u8_type")
type UInt8;

#lang("builtin_i32_type")
type Int32;

#lang("builtin_i64_type")
type Int64;

#lang("builtin_never_type")
type Never;

#lang("builtin_f64_type")
type Float64;

#lang("builtin_c_void_ptr_type")
type CVoidPtr;

#lang("builtin_raw_ptr_type")
type RawPtr[T];

#lang("builtin_c_char_type")
type CChar;


type Maybe [t]
    | Just of t
    | None

external fun printf(fmt: RawPtr[CChar], ...) -> Int32;
external fun puts(a: CVoidPtr) -> ()  = "leaf_rt__puts";
external fun itoa(a: Int32) -> CVoidPtr = "leaf_rt__itoa";

fun print_int(a)
    unsafe_call_external puts(unsafe_call_external itoa(a))


fun main()
    print_int(100)
